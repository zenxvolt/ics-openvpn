<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/shell_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/shell_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:minHeight="64dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@drawable/floating_nav"
        android:clipToOutline="true"
        app:backgroundTint="?attr/colorSurfaceContainer"
        app:elevation="3dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@drawable/nav_item_ripple"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemPaddingTop="8dp"
        app:itemPaddingBottom="8dp"
        app:itemTextAppearanceActive="@style/TextAppearance.OpenVPN.NavigationLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.OpenVPN.NavigationLabel"
        app:itemTextAppearanceActiveBoldEnabled="false"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/destinations" />
</LinearLayout>
